<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet  author="${DBType}_DBA"  id="${BUILD_NUMBER}" runOnChange="true">
        <tagDatabase  tag="${REQUEST_NUMBER}-${BUILD_NUMBER}"/>
    </changeSet>
    <changeSet id="$REQUEST_NUMBER-$FILE_FILENAME" author="${DBType}_DBA" runOnChange="true">
        <sqlFile path="DBScript/$sql_file"/>
    </changeSet>
</databaseChangeLog>
